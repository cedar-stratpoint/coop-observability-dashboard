[
 {
  "name": "repeat buyers in September",
  "input": {
   "table": "orders",
   "filters": [
    {
     "column": "created_at",
     "op": "gte",
     "value": "2026-09-01"
    },
    {
     "column": "created_at",
     "op": "lte",
     "value": "2026-09-30"
    }
   ],
   "select": [
    {
     "agg": "customers_with_min_orders",
     "min": 2,
     "as": "repeat_buyers"
    },
    {
     "agg": "count_distinct",
     "column": "email",
     "as": "emails"
    }
   ]
  },
  "crm": "accept"
 },
 {
  "name": "who the repeat buyers are (identity)",
  "input": {
   "table": "customers",
   "detail": "identity",
   "filters": [
    {
     "column": "orders_count",
     "op": "gte",
     "value": 2
    }
   ],
   "order_by": [
    {
     "by": "total_spent",
     "dir": "desc"
    }
   ],
   "limit": 50
  },
  "crm": "accept"
 },
 {
  "name": "discount codes used most",
  "input": {
   "table": "order_discount_codes",
   "filters": [
    {
     "column": "created_at",
     "op": "gte",
     "value": "2026-09-01"
    },
    {
     "column": "created_at",
     "op": "lte",
     "value": "2026-09-30"
    }
   ],
   "select": [
    {
     "agg": "count",
     "as": "uses"
    },
    {
     "agg": "sum",
     "column": "amount",
     "as": "given"
    }
   ],
   "group_by": [
    "code"
   ],
   "order_by": [
    {
     "by": "uses",
     "dir": "desc"
    }
   ],
   "limit": 10
  },
  "crm": "accept"
 },
 {
  "name": "abandoned carts and their value",
  "input": {
   "table": "checkouts",
   "filters": [
    {
     "column": "created_at",
     "op": "gte",
     "value": "2026-09-01"
    },
    {
     "column": "created_at",
     "op": "lte",
     "value": "2026-09-30"
    },
    {
     "column": "converted_at",
     "op": "is_null"
    }
   ],
   "select": [
    {
     "agg": "count",
     "as": "carts"
    },
    {
     "agg": "sum",
     "column": "total_price",
     "as": "value"
    }
   ]
  },
  "crm": "accept"
 },
 {
  "name": "refund rate per SKU (computed)",
  "input": {
   "table": "order_lines",
   "filters": [
    {
     "column": "created_at",
     "op": "gte",
     "value": "2026-09-01"
    },
    {
     "column": "created_at",
     "op": "lte",
     "value": "2026-09-30"
    }
   ],
   "select": [
    {
     "agg": "sum",
     "column": "line_gross",
     "as": "gross"
    },
    {
     "agg": "sum",
     "column": "line_discount",
     "as": "disc"
    },
    {
     "expr": {
      "op": "round",
      "args": [
       {
        "op": "/",
        "args": [
         {
          "ref": "disc"
         },
         {
          "ref": "gross"
         }
        ]
       },
       4
      ]
     },
     "as": "disc_rate"
    }
   ],
   "group_by": [
    "sku"
   ],
   "having": [
    {
     "by": "gross",
     "op": "gte",
     "value": 1000
    }
   ],
   "order_by": [
    {
     "by": "disc_rate",
     "dir": "desc"
    }
   ]
  },
  "crm": "accept"
 },
 {
  "name": "weekly units for the top 5 SKUs (top_n key)",
  "input": {
   "table": "order_lines",
   "filters": [
    {
     "column": "created_at",
     "op": "between",
     "value": [
      "2026-08-01",
      "2026-09-30"
     ]
    }
   ],
   "select": [
    {
     "agg": "sum",
     "column": "quantity",
     "as": "units"
    }
   ],
   "group_by": [
    "sku",
    {
     "column": "created_at",
     "bucket": "week",
     "as": "week"
    }
   ],
   "top_n": {
    "n": 5,
    "by": "units",
    "key": "sku"
   }
  },
  "crm": "accept"
 },
 {
  "name": "top 3 rows per week (top_n per)",
  "input": {
   "table": "order_lines",
   "filters": [
    {
     "column": "created_at",
     "op": "gte",
     "value": "2026-09-01"
    },
    {
     "column": "created_at",
     "op": "lte",
     "value": "2026-09-30"
    }
   ],
   "select": [
    {
     "agg": "sum",
     "column": "quantity",
     "as": "units"
    }
   ],
   "group_by": [
    {
     "column": "created_at",
     "bucket": "week",
     "as": "week"
    },
    "sku"
   ],
   "top_n": {
    "n": 3,
    "by": "units",
    "dir": "desc",
    "per": "week"
   }
  },
  "crm": "accept"
 },
 {
  "name": "orders joined to customers by tier",
