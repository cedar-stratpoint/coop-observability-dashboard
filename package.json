{
  "name": "zoomy-digest-dashboard",
  "private": true,
  "version": "1.4.1",
  "description": "Reader dashboard for Zoomy weekly store-ops digests. Renders archived DigestDocuments from Supabase (anon key + RLS). Separate app from zoomy-observability (the batch job that writes them).",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:pagination": "node scripts/check-pagination.mjs",
    "test": "vitest run",
    "shopee:import": "tsx scripts/shopee-import.ts",
    "sku:aliases": "tsx scripts/sku-aliases.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@base-ui/react": "^1.6.0",
    "@serwist/next": "^9.5.12",
    "@supabase/supabase-js": "^2.45.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "libpg-query": "17.7.4",
    "lucide-react": "^1.27.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "postgres": "3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vitest": "^4.1.11"
  }
}
