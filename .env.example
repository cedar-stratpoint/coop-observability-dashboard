# Server-side read of the digest_archive table in the OBSERVABILITY Supabase
# project. These are SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_, and never
# expose the service-role key to the browser. The table is not anon-readable
# (its bundle column holds verbatim customer quotes); the dashboard reads it in a
# Server Component with the service-role key and selects only the digest column.
# In Vercel, set these as (non-public) Environment Variables.
# Leave unset to run against built-in mock digests.
SUPABASE_URL_ARCHIVE=https://your-observability-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_ARCHIVE=your-archive-service-role-key

# Goldline (Nichido) data: Goldline's tables and the goldline-uploads bucket live in
# their own Nichido Supabase project, not the archive above. SERVER-ONLY, same rules
# as the archive key. Must be the SAME environment as the archive (Staging archive
# with Nichido Staging, prod with prod; refs in src/coop-env.ts) or Goldline pages
# stay empty. Leave unset and Goldline pages show nothing (no fallback to the archive).
NICHIDO_URL=https://your-nichido-ref.supabase.co
NICHIDO_SERVICE_ROLE_KEY=your-nichido-service-role-key

# Local dev only: skip Google sign-in so `next dev` loads straight into the
# dashboard. Ignored unless NODE_ENV is development, so it can never take effect
# on a Vercel deployment. Leave unset (or false) to require real sign-in.
# DEV_AUTH_BYPASS=true

# Website CRM (the /crm page). Live proxy to the Zoomy CRM Worker — the same
# API the storefront admin reads, so the two dashboards cannot disagree.
# CRM_API_READ_TOKEN is the READ-scoped token: it opens the Worker's /api
# surface and NOT /admin, where a POST starts a real customer email batch.
# Issue it with `wrangler secret put CRM_API_READ_TOKEN` in the zoomy-crm repo.
# SERVER-ONLY — never prefix with NEXT_PUBLIC_. Leave unset to render the page
# empty instead of wrong.
CRM_API_URL=https://zoomy-crm-prod.your-subdomain.workers.dev
CRM_API_READ_TOKEN=your-read-only-crm-token
# Ask Coop's website CRM tools (get_crm_metrics, list_crm_*) are on whenever CRM_API_URL and CRM_API_READ_TOKEN are set.
# CHAT_CRM_TOOLS=off hides the four tools; the Website CRM page and get_channel_report's Website row keep working.
# CHAT_CRM_TOOLS=off

# Ask Coop cost cap: input-token equivalents per question; default 300000 (optional).
# CHAT_TURN_BUDGET=300000

# Goldline's own Anthropic API key for inventory-form extraction (Claude Vision reads
# the scanned PDFs server-side). Separate from Ask Coop's ANTHROPIC_API_KEY; Goldline
# never falls back to it. SERVER-ONLY — never prefix with NEXT_PUBLIC_ and
# never commit the real value; set it as a (non-public) Environment Variable in
# Vercel (Staging first). Extraction runs in a server route, so the browser never
# sees it. Leave unset to disable PDF extraction (CSV upload still works).
GOLDLINE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ask Coop cost cap: input-token equivalents per question; default 300000 (optional).
# CHAT_TURN_BUDGET=300000

# Shopee export import API (app/api/shopee/import/*). One bearer token; unset = every call answers 503. Generate: openssl rand -hex 32
# Used by scripts and the weekly run on the Mac; never NEXT_PUBLIC_.
SHOPEE_IMPORT_TOKEN=

# Shopee same-day sync, one cloud worker. Server-only. "Admin" is the Coop Admin role: only an admin sees the remote browser address.
# The worker's ONE shared secret, sent as `Authorization: Bearer`. Random, 32+ bytes (openssl rand -base64 32); the same value is in AWS SSM
# /coop/shopee-worker/worker-token. Unset = claim, progress and the worker's import calls answer 503 (fail closed). Rotate it in both places to revoke.
SHOPEE_SYNC_WORKER_TOKEN=
# Bearer token the AWS Lambda sends to POST /api/shopee/sync/wake (random, 32+ bytes, a DIFFERENT value from the worker secret). Unset = the route answers 401 to everyone.
SHOPEE_SYNC_WAKE_TOKEN=
# Address of the worker's protected remote browser (noVNC behind Cloudflare Access), https only. Shown to a Coop Admin only. Unset or invalid = no link.
SHOPEE_SYNC_REMOTE_URL=
# Optional. Comma-separated hosts SHOPEE_SYNC_REMOTE_URL may use (exact match, case-insensitive). When set, any other host removes the link, so a look-alike
# page cannot be put where an admin types the Shopee password. Unset = any https address.
SHOPEE_SYNC_REMOTE_HOSTS=
