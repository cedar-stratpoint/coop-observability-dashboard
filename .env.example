# Server-side read of the digest_archive table in the OBSERVABILITY Supabase
# project. These are SERVER-ONLY — do NOT prefix with NEXT_PUBLIC_, and never
# expose the service-role key to the browser. The table is not anon-readable
# (its bundle column holds verbatim customer quotes); the dashboard reads it in a
# Server Component with the service-role key and selects only the digest column.
# In Vercel, set these as (non-public) Environment Variables.
# Leave unset to run against built-in mock digests.
SUPABASE_URL_ARCHIVE=https://your-observability-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY_ARCHIVE=your-archive-service-role-key

# Local dev only: skip Google sign-in so `next dev` loads straight into the
# dashboard. Ignored unless NODE_ENV is development, so it can never take effect
# on a Vercel deployment. Leave unset (or false) to require real sign-in.
# DEV_AUTH_BYPASS=true

# Website CRM (the /crm page). Live proxy to the Zoomy CRM Worker — the same
# API the storefront admin reads, so the two dashboards cannot disagree.
# CRM_API_READ_TOKEN is the READ-scoped token: it opens the Worker's /api
# surface and NOT /admin, where a POST starts a real customer email batch.
# Issue it with `wrangler secret put CRM_API_READ_TOKEN` in the zoomy-crm repo.
# SERVER-ONLY — never prefix with NEXT_PUBLIC_. Leave unset to render the page
# empty instead of wrong.
CRM_API_URL=https://zoomy-crm-prod.your-subdomain.workers.dev
CRM_API_READ_TOKEN=your-read-only-crm-token
# Ask Coop's website CRM tools (get_crm_metrics, list_crm_*) are on whenever CRM_API_URL and CRM_API_READ_TOKEN are set.
# CHAT_CRM_TOOLS=off hides the four tools; the Website CRM page and get_channel_report's Website row keep working.
# CHAT_CRM_TOOLS=off

# Anthropic API key for Goldline inventory-form extraction (Claude Vision reads
# the scanned PDFs server-side). SERVER-ONLY — never prefix with NEXT_PUBLIC_ and
# never commit the real value; set it as a (non-public) Environment Variable in
# Vercel (Staging first). Extraction runs in a server route, so the browser never
# sees it. Leave unset to disable PDF extraction (CSV upload still works).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Ask Coop cost cap: input-token equivalents per question; default 300000 (optional).
# CHAT_TURN_BUDGET=300000
